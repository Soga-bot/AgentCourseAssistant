# ============================================
# 初中数学双模式生成系统 - 配置文件
# ============================================

# ========== LLM 配置（豆包2.0 Pro 主推）==========
LLM_API_KEY=your_doubao_api_key_here
LLM_MODEL=doubao-seed-2-0-pro-260215
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=16384
LLM_MAX_CONCURRENT=3
LLM_TIMEOUT=180
LLM_MAX_RETRIES=5
LLM_REQUEST_INTERVAL=2.0

# ========== DeepSeek 备用配置（取消注释启用）==========
# LLM_API_KEY=your_deepseek_api_key_here
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com

# ========== 课程生成配置 ==========
COURSE_API_KEY=your_doubao_api_key_here
COURSE_MODEL=doubao-seed-2-0-pro-260215
COURSE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
COURSE_MAX_TOKENS=12000
COURSE_TEMPERATURE=0.1

# ========== 知识库配置 ==========
KNOWLEDGE_DIR=./knowledge

# ========== 导出配置 ==========
EXPORT_PDF_ENGINE=pandoc

# ========== FastAPI 服务配置 ==========
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# ========== 输出目录配置 ==========
OUTPUT_DIR=./output
TEMP_DIR=./temp

# ========== 任务清理配置 ==========
TASK_CLEANUP_ENABLED=true
TASK_RETENTION_HOURS=24
CLEANUP_INTERVAL_SECONDS=3600

# ========== 阿里云 TTS 语音合成配置 ==========
TTS_APPKEY=your_tts_appkey_here
TTS_TOKEN=your_tts_access_token_here
TTS_VOICE=zhida
TTS_FORMAT=mp3
TTS_BASE_URL=https://nls-gateway-cn-shanghai.aliyuncs.com/stream/v1/tts
TTS_MAX_CONCURRENT=2
TTS_REQUEST_INTERVAL=1.0
